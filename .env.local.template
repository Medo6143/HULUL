# Copy this file to .env.local and fill the values. .env.local is ignored by git: never commit real values.
# Run `npm run check:env` any time to see what is still missing (it never prints the values).

# ---------- Site ----------
# The real https:// domain. While it is example.com, robots.txt blocks all crawlers on purpose.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_DEFAULT_LOCALE=ar
# Official WhatsApp number, digits only, with country code. Example: 9665XXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ---------- Firebase web app (public values) ----------
# Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase service account (SECRET) ----------
# Firebase console > Project settings > Service accounts > Generate new private key.
# Copy three fields from the downloaded JSON, then delete the JSON file.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the quotes and the \n escapes exactly as in the JSON.
FIREBASE_ADMIN_PRIVATE_KEY=""

# ---------- reCAPTCHA v3 (spam protection) ----------
# https://www.google.com/recaptcha/admin : create a v3 key for your domain (and localhost for testing).
NEXT_PUBLIC_APPCHECK_RECAPTCHA_SITE_KEY=
APPCHECK_RECAPTCHA_SECRET=

# ---------- Email (Resend) ----------
# https://resend.com : verify your sending domain first, then create an API key.
RESEND_API_KEY=
EMAIL_FROM="HULOL TECH <hello@your-domain>"
TEAM_ALERT_EMAIL=
# Optional team chat alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Anti-abuse ----------
# Any long random string, different for each environment.
RATE_LIMIT_SALT=

# ---------- Analytics (leave empty to disable; nothing loads before consent anyway) ----------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_SNAP_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# ---------- Local only ----------
# 1 shows the admin with sample data. Ignored in production. Remove it once real data is connected.
ADMIN_DEMO=
