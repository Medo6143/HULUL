{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3100",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://localhost:3100/ar",
        "http://localhost:3100/ar/services/web",
        "http://localhost:3100/ar/start",
        "http://localhost:3100/en"
      ],
      "numberOfRuns": 2,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["warn", { "maxNumericValue": 153600 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
