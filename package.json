  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:emoji": "node scripts/check-no-emoji.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:direction": "node scripts/check-no-physical-direction.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run check:emoji && npm run check:i18n && npm run check:direction && npm run check:boundaries && npm run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "firebase": "^12.4.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.544.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-boundaries": "^5.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
